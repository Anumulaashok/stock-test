# Copy this file to .env and fill in values for your environment.
# Never commit a real .env file.

APP_NAME=stock-agent
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM provider: "local" (a self-hosted, OpenAI-compatible server, e.g.
# vLLM/Qwen) or "nvidia" (alias of "local" -- NVIDIA's hosted API is
# also OpenAI-compatible; use it with LOCAL_LLM_BASE_URL below).
LLM_PROVIDER=local

# Remote, OpenAI-compatible LLM server (e.g. a self-hosted Qwen model on
# another machine, or https://integrate.api.nvidia.com/v1 for NVIDIA).
# The app builds requests as POST {LOCAL_LLM_BASE_URL}/chat/completions
# with an "Authorization: Bearer ${LOCAL_LLM_API_KEY}" header -- do not
# include /chat/completions in this URL yourself.
LOCAL_LLM_BASE_URL=http://YOUR_SERVER_HOST:PORT/v1
LOCAL_LLM_MODEL=your-model-name
LOCAL_LLM_API_KEY=
LOCAL_LLM_CONNECT_TIMEOUT_SECONDS=5
# 120s default suits a CPU-only server (~5-8 tokens/sec) generating a
# multi-hundred-token structured analyst response (Step 5). Lower this
# if your server is GPU-backed and responds much faster.
LOCAL_LLM_TIMEOUT_SECONDS=120
# Whether the model's chat template should "think" before responding.
# Only takes effect when LOCAL_LLM_REASONING_MODE=thinking (below).
# Kept configurable rather than hardcoded; the /health/llm connectivity
# check always forces this off regardless of this setting.
LOCAL_LLM_ENABLE_THINKING=false

# How the "don't think out loud" instruction is expressed to the
# server's chat template -- this isn't standardized across
# OpenAI-compatible backends:
# - "thinking": send chat_template_kwargs.enable_thinking (vLLM/Qwen
#   servers honor this).
# - "reasoning_effort": send chat_template_kwargs.reasoning_effort
#   ("low"/"medium"/"high") -- required for OpenAI gpt-oss-style
#   reasoning models (e.g. NVIDIA's hosted openai/gpt-oss-20b), which
#   ignore enable_thinking and reason at full effort regardless, easily
#   consuming the entire response token budget with no room left for
#   the actual answer.
# - "none": send neither key.
LOCAL_LLM_REASONING_MODE=thinking
LOCAL_LLM_REASONING_EFFORT=low

# Requests the server constrain decoding to valid JSON syntax (OpenAI-
# style response_format: {"type": "json_object"}). Off by default since
# not every OpenAI-compatible server recognizes this field. Turn this on
# for backends that do (NVIDIA's hosted API does) -- without it, some
# reasoning models occasionally emit free-form text that isn't valid
# JSON (e.g. a stray curly quote breaking a string) even when the
# response wasn't truncated.
LOCAL_LLM_JSON_MODE=false

# AI analyst response budget (tokens). 700 suits the CPU-only Qwen3-8B
# reference server. A reasoning model (LOCAL_LLM_REASONING_MODE=
# reasoning_effort) spends part of this budget on internal
# chain-of-thought before writing the final JSON answer -- raise this to
# 4000+ for those (measured against a real multi-metric analysis: 2200
# still truncated), or responses will come back truncated/empty.
ANALYST_MAX_RESPONSE_TOKENS=700

# Q&A assistant response budget (tokens) -- same reasoning-model caveat
# as ANALYST_MAX_RESPONSE_TOKENS above applies here: a reasoning model
# burns part of this budget on internal chain-of-thought before writing
# the JSON answer, so raise this the same way (4000+) if answers come
# back empty/truncated for that kind of backend.
QA_MAX_RESPONSE_TOKENS=400

# API response caching -- backed by the app's own SQL database (see
# app/cache/), not a separate cache service. Financial statements don't
# change intra-day, so the default TTL here is days; a market quote is
# live data, so its default TTL is seconds.
FINANCIAL_DATA_CACHE_TTL_SECONDS=604800
MARKET_DATA_CACHE_TTL_SECONDS=30

# External financial data provider SELECTION only -- a provider
# identifier, never a URL. Supported: "fmp", "indianapi". Only the
# selected provider's own settings below need to be configured; the
# other provider's settings can be left blank.
FINANCIAL_DATA_PROVIDER=fmp

# Financial Modeling Prep (used when FINANCIAL_DATA_PROVIDER=fmp). Get a
# free API key at https://site.financialmodelingprep.com/register — the
# free tier (250 requests/day as of 2026) includes the annual income
# statement, balance sheet, and cash flow statement endpoints this app
# uses.
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com/stable
FMP_CONNECT_TIMEOUT_SECONDS=5
FMP_TIMEOUT_SECONDS=15
FMP_MAX_RETRIES=2
FMP_ANNUAL_PERIODS_LIMIT=5

# IndianAPI / stock.indianapi.in (used when FINANCIAL_DATA_PROVIDER=indianapi).
# Get an API key at https://indianapi.in — this endpoint is name-search
# based (queries by company name/search term, not a strict exchange
# ticker) and authenticates via an X-Api-Key header.
INDIAN_API_KEY=
INDIAN_API_BASE_URL=https://stock.indianapi.in
INDIAN_API_CONNECT_TIMEOUT_SECONDS=5
INDIAN_API_TIMEOUT_SECONDS=15
INDIAN_API_MAX_RETRIES=2

# External research/market-context provider (Step 8): "finnhub" is the
# only one implemented so far. Get a free API key at
# https://finnhub.io/register — the free tier (60 requests/minute as of
# 2026, no credit card required) includes the company-news endpoint this
# app uses. Research is optional: leave this unset and the app runs
# fully without it; a caller must explicitly opt in per request.
RESEARCH_PROVIDER=finnhub
RESEARCH_API_KEY=
RESEARCH_BASE_URL=https://finnhub.io/api/v1
RESEARCH_CONNECT_TIMEOUT_SECONDS=5
RESEARCH_TIMEOUT_SECONDS=10
RESEARCH_MAX_RETRIES=1
RESEARCH_DEFAULT_DAYS=30
RESEARCH_DEFAULT_MAX_RESULTS=5
RESEARCH_STALE_AFTER_DAYS=14

# Database. Defaults to a local SQLite file (no setup required); override
# with a Postgres URL in production, e.g.:
# DATABASE_URL=postgresql+asyncpg://stock_agent:stock_agent@localhost:5444/stock_agent
DATABASE_URL=sqlite+aiosqlite:///./stock_agent.db

# Auth (Step 11) — JWT bearer tokens. CHANGE JWT_SECRET_KEY in any
# non-development environment; the default below is intentionally
# insecure so the app still runs out of the box for local development.
JWT_SECRET_KEY=dev-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=10080

# Market data provider SELECTION only (Step 11) -- a provider identifier,
# not a URL, mirroring FINANCIAL_DATA_PROVIDER's policy. Supported: "fmp",
# "indianapi". This is a separate abstraction from FINANCIAL_DATA_PROVIDER
# (market quotes are not financial statements) but each reuses that
# provider's own keys configured above -- no separate API key needed.
# NOTE: FMP's quote/historical-price endpoints require a paid plan for
# non-US (NSE/BSE) symbols -- use "indianapi" for Indian tickers.
MARKET_DATA_PROVIDER=fmp
MARKET_DATA_CONNECT_TIMEOUT_SECONDS=5
MARKET_DATA_TIMEOUT_SECONDS=10
MARKET_DATA_MAX_RETRIES=1
# 200+ trading days needed for a 200-day moving average forecast.
MARKET_DATA_RECENT_PRICES_LIMIT=210
