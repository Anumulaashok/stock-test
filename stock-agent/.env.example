# Copy this file to .env and fill in values for your environment.
# Never commit a real .env file.

APP_NAME=stock-agent
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM provider: "local" is the only supported value for now.
LLM_PROVIDER=local

# Remote, OpenAI-compatible LLM server (e.g. a self-hosted Qwen model on
# another machine, reachable over HTTP). The app builds requests as
# POST {LOCAL_LLM_BASE_URL}/chat/completions with an
# "Authorization: Bearer ${LOCAL_LLM_API_KEY}" header.
LOCAL_LLM_BASE_URL=http://YOUR_SERVER_HOST:PORT/v1
LOCAL_LLM_MODEL=your-model-name
LOCAL_LLM_API_KEY=
LOCAL_LLM_CONNECT_TIMEOUT_SECONDS=5
# 120s default suits a CPU-only server (~5-8 tokens/sec) generating a
# multi-hundred-token structured analyst response (Step 5). Lower this
# if your server is GPU-backed and responds much faster.
LOCAL_LLM_TIMEOUT_SECONDS=120
# Whether the model's chat template should "think" before responding.
# Kept configurable rather than hardcoded; the /health/llm connectivity
# check always forces this off regardless of this setting.
LOCAL_LLM_ENABLE_THINKING=false

# External financial data provider SELECTION only -- a provider
# identifier, never a URL. Supported: "fmp", "indianapi". Only the
# selected provider's own settings below need to be configured; the
# other provider's settings can be left blank.
FINANCIAL_DATA_PROVIDER=fmp

# Financial Modeling Prep (used when FINANCIAL_DATA_PROVIDER=fmp). Get a
# free API key at https://site.financialmodelingprep.com/register — the
# free tier (250 requests/day as of 2026) includes the annual income
# statement, balance sheet, and cash flow statement endpoints this app
# uses.
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com/stable
FMP_CONNECT_TIMEOUT_SECONDS=5
FMP_TIMEOUT_SECONDS=15
FMP_MAX_RETRIES=2
FMP_ANNUAL_PERIODS_LIMIT=5

# IndianAPI / stock.indianapi.in (used when FINANCIAL_DATA_PROVIDER=indianapi).
# Get an API key at https://indianapi.in — this endpoint is name-search
# based (queries by company name/search term, not a strict exchange
# ticker) and authenticates via an X-Api-Key header.
INDIAN_API_KEY=
INDIAN_API_BASE_URL=https://stock.indianapi.in
INDIAN_API_CONNECT_TIMEOUT_SECONDS=5
INDIAN_API_TIMEOUT_SECONDS=15
INDIAN_API_MAX_RETRIES=2

# Database. Defaults to a local SQLite file (no setup required); override
# with a Postgres URL in production, e.g.:
# DATABASE_URL=postgresql+asyncpg://stock_agent:stock_agent@localhost:5444/stock_agent
DATABASE_URL=sqlite+aiosqlite:///./stock_agent.db

# Auth (Step 11) — JWT bearer tokens. CHANGE JWT_SECRET_KEY in any
# non-development environment; the default below is intentionally
# insecure so the app still runs out of the box for local development.
JWT_SECRET_KEY=dev-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=10080

# Market data provider SELECTION only (Step 11) -- a provider identifier,
# not a URL, mirroring FINANCIAL_DATA_PROVIDER's policy. Supported: "fmp".
# This is a separate abstraction from FINANCIAL_DATA_PROVIDER (market
# quotes are not financial statements) but "fmp" reuses the FMP_* keys
# configured above -- no separate API key needed.
MARKET_DATA_PROVIDER=fmp
MARKET_DATA_CONNECT_TIMEOUT_SECONDS=5
MARKET_DATA_TIMEOUT_SECONDS=10
MARKET_DATA_MAX_RETRIES=1
MARKET_DATA_RECENT_PRICES_LIMIT=30
